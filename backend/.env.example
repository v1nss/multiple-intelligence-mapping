PORT=5000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mim_system

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_RESET_SECRET=replace-with-a-different-long-random-secret
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

BCRYPT_ROUNDS=12
NODE_ENV=development

# SMTP configuration for password reset emails.
# If omitted in development, reset links are logged to backend console.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="MIM System <no-reply@example.com>"
